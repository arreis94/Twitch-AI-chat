# Twitch application credentials (register at https://dev.twitch.tv/console/apps)
# Redirect URI must be: http://localhost:3000/api/auth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# The channel the simulated chatters join (the customer's channel login name, lowercase)
TARGET_CHANNEL=

# Azure AI Foundry project (optional — AI persona features are disabled if unset)
# Example: https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT=gpt-4o-mini

# Backend port
PORT=3000
